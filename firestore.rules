rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Account & Minimal Profile ONLY:
    // Strictly blocks any financial fields or financial subcollections from Cloud Firestore.
    // Single Source of Truth for Financial Data is Local Room Database.
    match /users/{userId} {
      // Allow reading user profile
      allow read: if isOwner(userId);

      // Strictly allow writing ONLY minimal account/profile fields (no financial data allowed)
      allow create, update: if isOwner(userId) &&
        request.resource.data.keys().hasOnly([
          'userId', 'uid', 'displayName', 'email', 'phoneNumber', 'profileImageUrl', 'createdAt', 'updatedAt'
        ]);

      // Allow deleting user account document upon account deletion
      allow delete: if isOwner(userId);

      // Explicitly DENY all financial and other subcollections
      match /{allSubcollections=**} {
        allow read, write: if false;
      }
    }

    // Explicitly DENY any legacy or top-level collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
